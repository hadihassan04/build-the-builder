# Copy to .env (or env.sh) and fill in. Never commit real keys.

# Freya workspace API key (dashboard → API keys)
FREYA_API_KEY=

# Practice bank team key — make one up, ≥16 chars, keep it stable across practice runs
FREYA_BANK_TEAM_KEY=replace-me-with-a-stable-team-key

# Optional: builder LLM (only if your extract path uses one)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
